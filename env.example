# Copy to .env.local for local development.
# For Vercel: add these in Project → Settings → Environment Variables.

# Required for database (Neon). Needed at build time for /dashboard.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for NextAuth (Google login)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth URL (Vercel sets VERCEL_URL; for production set AUTH_URL)
# AUTH_URL=https://your-domain.com

# Required for SendGrid (welcome email, feedback email)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@your-verified-domain.com

# Optional: for AI summary of student progress (server-side only)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Optional override; must support Responses API and reasoning.effort=none
OPENAI_MODEL=gpt-5.6-terra

# Required for BFT Learn admin API calls (create account, list content)
ADMIN_API_KEY=your-bft-admin-api-key

# BFT Learn API host only — do not include /admin/content (default: https://bft-api.onrender.com)
# BFT_API_BASE_URL=https://bft-api.onrender.com
